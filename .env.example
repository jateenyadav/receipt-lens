# Local dev reads .env and ~/Desktop/RND/.secrets/shared.env. Leave everything empty to run
# fully offline: an in-memory database and the fake AI start automatically.
MONGODB_URI=
MONGODB_DB=receipt-lens
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional: a Groq model that can read images, used if Gemini is busy (e.g. a Llama 4 vision model)
GROQ_VISION_MODEL=
GEMINI_REASONING_EFFORT=none
AI_PER_DAY=60
AI_BUDGET_MS=8000
WEB_ORIGINS=
